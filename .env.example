# Copy this file to `.env.local` and fill in real values.
# `.env` and `.env.local` are git-ignored and must never be committed.
#
# Placeholders only - never write a real key into this file.

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------

# Which provider generates study material: `groq` or `gemini`.
# If unset, Groq is used when GROQ_API_KEY is present, otherwise Gemini.
AI_PROVIDER=groq

# --- GroqCloud (openai/gpt-oss-120b) ---------------------------------------
# Server-side only. Never expose to client code.

# Groq API key, from https://console.groq.com/keys
GROQ_API_KEY=

# Model identifier. Defaults to `openai/gpt-oss-120b` when unset.
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (still supported; set AI_PROVIDER=gemini to use) --------

# Server-side only. Never expose to client code.

# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model identifier used for summary, diagram, and quiz generation.
GEMINI_MODEL=gemini-2.5-flash