{
  "name": "pdf-summarizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI study material summarizer: uploads PDF/PPTX and generates summaries, Mermaid diagrams, and a 20-question MCQ quiz.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
